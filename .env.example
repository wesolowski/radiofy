# Spotify Developer credentials
# Create an app at https://developer.spotify.com/dashboard, then paste the
# Client ID / Secret here. The redirect URI must match what you registered
# in the Spotify app settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Logging
LOG_LEVEL=info

# Dead-man switch (optional, but strongly recommended for scheduled runs).
# Sign up with a cron-monitoring service, create one check per scheduled job,
# and paste its ping URL here. The scheduling wrapper sends a start signal, a
# success signal and a failure signal; the service raises the alarm when the
# expected signal simply never arrives — which is what catches a job that is
# not running at all. Leave empty to schedule without monitoring.
# TREAT THESE LIKE PASSWORDS: anyone holding the URL can silence your alarm.
RADIOFY_HEALTHCHECK_WEEKLY=
RADIOFY_HEALTHCHECK_CHART=
# Monthly pruning is not worth an alarm — a missed run costs disk space, not
# data — so this is left unset and the wrapper stays silent for those jobs.
# RADIOFY_HEALTHCHECK_HOUSEKEEPING=

# Integration tests — leave unset on CI and for unit-test-only runs.
# Set RADIOFY_INTEGRATION=1 to enable tests that hit the real Spotify API.
RADIOFY_INTEGRATION=
# Name of the playlist the integration tests are allowed to read/write.
# Create it in Spotify first; the tests refuse to run if it doesn't exist.
RADIOFY_INTEGRATION_PLAYLIST=
