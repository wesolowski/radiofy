# Radiofy crontab — weekly refresh, daily chart, monthly housekeeping.
#
# Install:
#   crontab -e                   # paste the lines below, then save & exit
#   crontab -l                   # verify
#
# Three things to adjust before pasting:
#   1. PATHS:  set RADIOFY to your checkout, and BUN to `which bun`
#   2. TIMEZONE: CRON_TZ pins the schedule to Europe/Warsaw regardless of the
#      server's clock. Remove the line if the server is already on
#      Europe/Warsaw, or change it for a different reference timezone.
#   3. MONITORING: put your health-check URLs in the checkout's .env as
#      RADIOFY_HEALTHCHECK_WEEKLY and RADIOFY_HEALTHCHECK_CHART. They are
#      looked up by name below, so the URLs never appear in this file or in
#      `ps` output. Without them the jobs still run, silently.

CRON_TZ=Europe/Warsaw
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

RADIOFY=/home/youruser/radiofy
BUN=/usr/local/bin/bun
RUN=/home/youruser/radiofy/docs/operations/bin/radiofy-cron.sh

# ─── Weekly refresh — Sunday 04:00 Europe/Warsaw ────────────────────────────
# Crawls the past week for every enabled station, then replaces every station
# playlist. One job, one exit code, one health check.
0  4 * * 0  $RUN RADIOFY_HEALTHCHECK_WEEKLY weekly

# ─── Chart — daily 05:00 Europe/Warsaw ──────────────────────────────────────
# A chart moves on its own rhythm, independent of the station schedule.
# Remove this line if you have no chart configured in config/charts.json.
0  5 * * *  $RUN RADIOFY_HEALTHCHECK_CHART chart

# ─── Optional: daily crawl — 03:00 Europe/Warsaw ────────────────────────────
# The weekly job already crawls the whole week, so this is not required. Add it
# if you want ingestion to repair itself mid-week: each run re-crawls the last
# seven days, so a day lost to a source outage is picked up the next morning
# instead of being missed until the following Sunday.
# 0  3 * * *  $RUN RADIOFY_HEALTHCHECK_CRAWL crawl

# ─── Optional: monthly housekeeping ────────────────────────────────────────
# 1st of the month at 05:00 Europe/Warsaw — keeps the local SQLite db small.
# prune-audit  drops crawl_runs / playlist_sync_runs rows older than 90 days
# prune-plays  drops the play history older than 30 days
# sync still works fine — it only needs the rolling 7-day window.
# No health check is configured for these: a missed housekeeping run costs
# disk space, not data, and the unset variable makes the wrapper stay silent.
0  5 1 * *  $RUN RADIOFY_HEALTHCHECK_HOUSEKEEPING prune-audit
5  5 1 * *  $RUN RADIOFY_HEALTHCHECK_HOUSEKEEPING prune-plays
